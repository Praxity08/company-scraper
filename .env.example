# Copy to .env and fill in. Never commit .env. The same two names go into Vercel's settings.
# Hunter.io API key. On this Mac it is kept in the login Keychain instead (encrypted):
#   service "company-scraper", account "HUNTER_API_KEY". Leave this empty unless you have no Keychain.
HUNTER_API_KEY=
# Neon project "company-scraper": the POOLED connection string (Neon -> Connect).
# On this Mac it is kept in the login Keychain instead: service "company-scraper", account "DATABASE_URL".
DATABASE_URL=
