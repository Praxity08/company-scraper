# Copy to .env and fill in. Never commit .env. The same names go into Vercel's settings (mark each one Sensitive). On this Mac all of them live in the login Keychain (service "company-scraper").
# TO_EMAIL = your own Resend sign-up address: the ONLY address drafts are ever sent to. GEMINI_MODEL is optional.
# Hunter.io API key. On this Mac it is kept in the login Keychain instead (encrypted):
#   service "company-scraper", account "HUNTER_API_KEY". Leave this empty unless you have no Keychain.
HUNTER_API_KEY=
# Neon project "company-scraper": the POOLED connection string (Neon -> Connect).
# On this Mac it is kept in the login Keychain instead: service "company-scraper", account "DATABASE_URL".
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
SERPER_API_KEY=
RESEND_API_KEY=
TO_EMAIL=
